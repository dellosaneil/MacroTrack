<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Progress photo reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sets reminders again after a restart, which clears them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminders on the minute; inexact alarms can come many minutes late. Android 14+ asks for it in settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The barcode scanner needs a camera, but the app works without one. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MacroTrack">
        <!-- Off on debug builds; release builds follow the in-app choice in Profile. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analyticsEnabled}" />
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reminds on the days picked for each progress photo album. -->
        <receiver
            android:name=".core.platform.PhotoReminderReceiver"
            android:exported="false" />
        <!-- Missed-log reminders: goes off at each reminder time, and after a restart or update sets them again. -->
        <receiver
            android:name=".core.platform.LogReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Water reminders: checks the pace at each reminder time. -->
        <receiver
            android:name=".core.platform.WaterReminderReceiver"
            android:exported="false" />
        <!-- Checklist reminders: shows what's due and not yet ticked at each reminder time, and their buttons. -->
        <receiver
            android:name=".core.platform.ChecklistReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.platform.ChecklistActionReceiver"
            android:exported="false" />
        <!-- The buttons on a missed-log reminder that don't open the app. -->
        <receiver
            android:name=".core.platform.LogReminderActionReceiver"
            android:exported="false" />
        <!-- Home screen widgets, and the setup that opens when one is placed or edited. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.WaterWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_water_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>
        <receiver
            android:name=".widget.WeightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_weight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight_info" />
        </receiver>
        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickLogWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_log_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_log_info" />
        </receiver>
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MacroTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Shares exports and backups with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
